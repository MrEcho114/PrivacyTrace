# Server-side project settings; environment values are used until settings are saved.
PRIVACYTRACE_LLM_ENABLED=0
PRIVACYTRACE_LLM_API_BASE=
PRIVACYTRACE_LLM_MODEL=
PRIVACYTRACE_LLM_API_KEY=

# JSON remains the default. PostgreSQL is explicit and never imports local JSON.
PRIVACYTRACE_STORAGE=json
# Runtime role only; keep passwords outside source control.
PRIVACYTRACE_DATABASE_URL=
# Stable UUID for this service instance; distinct instances must use distinct UUIDs.
PRIVACYTRACE_INSTANCE_ID=
# Operator-only migration process, never consumed by API startup.
PRIVACYTRACE_MIGRATION_DATABASE_URL=
