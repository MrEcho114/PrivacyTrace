{
  "name": "privacytrace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @privacytrace/web",
    "dev:start": "node scripts/frontend-preview.cjs start",
    "dev:stop": "node scripts/frontend-preview.cjs stop",
    "dev:status": "node scripts/frontend-preview.cjs status",
    "check": "node scripts/frontend-preview.cjs check",
    "build": "npm run build --workspace @privacytrace/web",
    "typecheck": "npm run typecheck --workspace @privacytrace/web",
    "preview": "npm run preview --workspace @privacytrace/web",
    "fixtures:acceptance": "uv run --project apps/api python scripts/build_acceptance_fixtures.py",
    "acceptance:browser": "node scripts/verify-browser-acceptance.cjs",
    "acceptance:frontend": "node scripts/verify-frontend-flow.cjs && node scripts/verify-policy-assist.cjs && node scripts/verify-copy-contract.cjs",
    "acceptance:hierarchy": "node scripts/verify-issue143-hierarchy.cjs",
    "acceptance:live": "node scripts/verify-live-flow.cjs",
    "acceptance:mobile": "node scripts/verify-mobile-flow.cjs",
    "acceptance:design": "npm run build && node scripts/verify-design-foundation.cjs",
    "acceptance:reading": "node scripts/verify-mobile-reading.cjs",
    "acceptance:motion": "node scripts/verify-issue146-motion.cjs",
    "verify:brand": "node scripts/verify-brand-assets.cjs",
    "acceptance:preview": "node scripts/verify-frontend-preview.cjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
