{
  "$defs": {
    "AnalysisJob": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "input_mode": {
          "enum": [
            "SYNTHETIC",
            "APK"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUEUED",
            "INTAKE",
            "STATIC_ANALYSIS",
            "POLICY_PARSING",
            "EVALUATING",
            "REPORTING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "State",
          "type": "string"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "package_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Name"
        },
        "version_code": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Code"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "product_scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Scope"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "sample_id",
        "input_mode",
        "state",
        "ruleset_version",
        "created_at"
      ],
      "title": "AnalysisJob",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "jobs": {
      "items": {
        "$ref": "#/$defs/AnalysisJob"
      },
      "title": "Jobs",
      "type": "array"
    }
  },
  "required": [
    "jobs"
  ],
  "title": "JobsResponse",
  "type": "object"
}
