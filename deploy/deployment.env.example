# Copy outside the checkout. No passwords, task credentials or model keys here.
# Replace application placeholders with registry digests AFTER building this SHA.
PT_API_IMAGE=registry.example.invalid/privacytrace/api@sha256:REPLACE_WITH_64_HEX
PT_WEB_IMAGE=registry.example.invalid/privacytrace/web@sha256:REPLACE_WITH_64_HEX
PT_PUBLIC_HOST=privacytrace.example.invalid
PT_INSTANCE_ID=REPLACE_WITH_STABLE_UUID
PT_SECRETS_DIR=/etc/privacytrace/secrets

# Public release remains disabled in the embedded runtime contract.
PT_DEPLOY_MODE=isolated
PT_PUBLIC_BIND_IP=127.0.0.1

# Docker control network has no external default route; host-side fixed relay required.
PT_CONTROL_SUBNET=172.29.98.0/24
PT_CONTROL_GATEWAY_IP=172.29.98.1
PT_GATEWAY_CONTAINER_IP=172.29.98.10
# Published 8443 must bind an existing private/VPN host interface, never 0.0.0.0.
PT_GATEWAY_HOST_IP=10.77.0.10
PT_GATEWAY_PEERS=REPLACE_WITH_APPROVED_PEER_SHA256

# The dedicated scan host/VM Runner endpoint must be a private, non-loopback HTTPS
# address reachable through the host relay above; the image ID is the fixed digest.
PT_RUNNER_URL=https://172.29.98.1:8444
PT_RUNNER_IMAGE_ID=sha256:REPLACE_WITH_FIXED_RUNNER_IMAGE_DIGEST

# Compose secrets are files under PT_SECRETS_DIR, owned by each service UID:
#   runtime_database_url  migration_database_url  postgres_password  redis.conf
#   runtime_broker_url    runtime_health_url       material.key
#   control_ca.pem  control_cert.pem  control_key.pem
#   gateway_ca.pem  gateway_cert.pem  gateway_key.pem
# Never inline these values here or in any environment variable.
